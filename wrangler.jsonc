{
  "name": "shippingapp",
  "compatibility_date": "2026-08-13",
  "main": "./worker/entry.ts",
  "vars": {
    "AUTH_ENFORCEMENT": "true",
    "CLERK_AUTHORIZED_PARTIES": "https://shippingapp.marciofabrizio.workers.dev",
    "EMAIL_APP_NAME": "ShippingAPP",
    "EMAIL_PUBLIC_BASE_URL": "https://shippingapp.marciofabrizio.workers.dev",
    "EMAIL_SENDING_ENABLED": "false",
    "EMAIL_DELIVERY_MODE": "off"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MERCADOLIBRE_TOKEN_STORE",
      "id": "4e4a1a22926f4dcdb8242cf0b5d845d1"
    }
  ]
}
