{
  "name": "shippingapp",
  "compatibility_date": "2026-08-13",
  "main": "./worker/router.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [
    {
      "binding": "MERCADOLIBRE_TOKEN_STORE",
      "id": "4e4a1a22926f4dcdb8242cf0b5d845d1"
    }
  ]
}
